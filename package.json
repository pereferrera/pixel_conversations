{
  "name": "pixel-conversations",
  "private": true,
  "type": "module",
  "scripts": {
    "app": "npm run app:build && node debug/server.mjs",
    "app:build": "tsc -p app/tsconfig.json",
    "debug": "npm run debug:build && node debug/server.mjs",
    "debug:build": "tsc -p debug/tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test engine/**/*.test.ts rendering/*.test.ts debug/*.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
